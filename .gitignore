# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Generated artifacts (rebuild with: make ingest) ───────────────────────────
# These are large binary/JSON files produced by the indexing pipeline.
# Re-generate with: make ingest
artifacts/

# ── Eval reports (generated, can be many) ─────────────────────────────────────
# Individual run reports are generated by make eval / the dashboard.
# The eval datasets (eval/datasets/*.jsonl) ARE committed — they are needed
# to reproduce benchmarks.
eval/reports/

# ── User data ─────────────────────────────────────────────────────────────────
# The sample Wikipedia dataset (data/wikipedia/) IS committed as a quickstart.
# Add your own private data files here to keep them out of git.
data/*.csv
data/*.pdf
data/*.json
# Uncomment the line below to exclude ALL data (including Wikipedia sample):
# data/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.env
.env.local
.env.*.local

# ── Claude Code internal files ───────────────────────────────────────────────
.claude/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Temp config files written by dashboard ────────────────────────────────────
/tmp/rag_*
